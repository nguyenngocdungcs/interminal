{
  "name": "interminal",
  "version": "0.1.0",
  "description": "Interactive Terminal Companion Plugin for AI Agents",
  "type": "module",
  "main": "dist/backend/index.js",
  "bin": {
    "interminal": "dist/backend/index.js"
  },
  "scripts": {
    "build:frontend": "vite build",
    "build:backend": "tsup src/backend/index.ts --format esm --out-dir dist/backend --clean --dts",
    "build": "npm run build:frontend && npm run build:backend",
    "dev:backend": "tsx watch src/backend/index.ts",
    "dev:frontend": "vite",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "node dist/backend/index.js",
    "start:mcp": "node dist/backend/index.js --mcp",
    "test": "tsx tests/pty.test.mjs && tsx tests/command-lifecycle.test.mjs && tsx tests/mcp-tools.test.mjs && tsx tests/integration.test.mjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "keywords": [
    "mcp",
    "terminal",
    "ai-agent",
    "node-pty",
    "xterm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "fastify": "^5.2.1",
    "lucide-react": "^0.475.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
